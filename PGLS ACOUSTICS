## Phylogenetic Generalized Least-Squares (PGLS) in Acoustics

#Model selection for acoustic multivariate
resp_var = 'measure'  # define response variable

# Create a list containing one-sided formulas for all the candidate models
form_list = list(
  ~ trait/1,                              #mod1
  ~ trait/beak,                           #mod2
  ~ trait/bodyMass,                       #mod3
  ~ trait/ElevationRange,                 #mod4
  ~ trait/habitat,                        #mod5
  ~ trait/Clade,                          #mod6
  ~ trait/beak + ElevationRange,          #mod7
  ~ trait/beak + habitat,                 #mod8
  ~ trait/beak + Clade,                   #mod9
  ~ trait/beak * ElevationRange,          #mod10
  ~ trait/beak * habitat,                 #mod11
  ~ trait/beak * Clade,                   #mod12
  ~ trait/bodyMass + ElevationRange,      #mod13
  ~ trait/bodyMass + habitat,             #mod14
  ~ trait/bodyMass + Clade,               #mod15
  ~ trait/bodyMass * ElevationRange,      #mod16
  ~ trait/bodyMass * habitat,             #mod17
  ~ trait/bodyMass * Clade)               #mod18

mod_list= list() # Empty list to save results

# Now iterate through each formula in the form_list...
mod_list_lambda = list() # Empty list to save results

#To include the phylogenetic correlations, we are going to test three evolutionary models in this section: 

### Pagel's lambda optimization 

# Find species in data that are NOT in the tree
missing_from_tree <- setdiff(unique(acoustics_long$Specie), tree_spp$tip.label)
print(missing_from_tree)

# Keep only rows where the species exists in the tree
acoustics_long <- acoustics_long[acoustics_long$Specie %in% tree_spp$tip.label, ]

# Drop unused factor levels
acoustics_long$Specie <- droplevels(as.factor(acoustics_long$Specie))

for (n in 1:length(form_list)){
  # ... paste in the name of the response variable...
  formula_n = formula(paste(resp_var, form_list[n])) 
  #...fit the model, and save it in the mod_list...
  mod_list_lambda[[n]] = gls(formula_n, data = acoustics_long, 
                             correlation = corPagel(1, phy = tree_spp, 
                                                    form = ~ Specie), 
                             method = 'ML',
                             na.action = na.omit)
  #...and print out which iteration was just completed
  print(paste('model number: ', n, ' - fit - ', formula_n))
}

names(mod_list_lambda) = form_list

#Refitting the same models, but with modified formula for the Pagel correlation structure, in which phylogenetic correlation applies within traits but not between them:
  
mod_list_lambda_2 = list() # Empty list to save results

# Now iterate through each formula in the form_list...
for (n in 1:length(form_list)){
  # ... paste in the name of the response variable...
  formula_n = formula(paste(resp_var, form_list[n])) 
  #...fit the model, and save it in the mod_list...
  mod_list_lambda_2[[n]] = gls(formula_n, data = acoustics_long, 
                               correlation = corPagel(1, phy = tree_spp, 
                                                      form = ~ Specie|trait), 
                               method = 'ML',
                               na.action = na.omit)
  #...and print out which iteration was just completed
  print(paste('model number: ', n, ' - fit - ', formula_n))
}

names(mod_list_lambda_2) = form_list
